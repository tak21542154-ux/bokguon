# ══════════════════════════════════════════════════════════════
#  복구온 서비스 — systemd 유닛 (Linux 자동 실행)
#  ㈜올림포스네트웍스 기획팀 유경탁
#
#  설치:
#    sudo cp bokguon.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now bokguon
#    sudo systemctl status bokguon
# ══════════════════════════════════════════════════════════════
[Unit]
Description=Bokguon Service (기타피해물 복구 역경매 플랫폼)
After=network.target

[Service]
Type=simple
User=bokguon
Group=bokguon
WorkingDirectory=/opt/bokguon
EnvironmentFile=/opt/bokguon/.env
ExecStart=/opt/bokguon/venv/bin/gunicorn -c gunicorn_conf.py wsgi:application
Restart=always
RestartSec=5

# ── [보안] 프로세스 격리 (systemd 하드닝) ──
#  침해가 발생해도 이 프로세스가 할 수 있는 일을 최소로 줄인다.
#  `systemd-analyze security bokguon` 으로 점수를 확인할 수 있다.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# 쓰기 가능한 경로
#  이상적으로는 데이터 디렉터리만 열고 코드는 읽기 전용으로 두는 것이 맞다.
#  다만 SQLite 가 DB 파일과 같은 디렉터리에 저널(-wal/-shm)을 만들기 때문에,
#  데이터를 /var/lib/bokguon 으로 분리하기 전까지는 앱 디렉터리를 열어야 한다.
#  (분리 작업은 DEPLOY.md 7장 '알려진 제약'에 남겨 두었다)
# ⚠ 개별 파일을 나열하면 안 된다.
#   ProtectSystem=strict 아래에서 ReadWritePaths 에 적힌 경로가 기동 시점에 존재하지 않으면
#   systemd 가 유닛을 아예 띄우지 않는다. 그런데
#     · bokguon.db-wal / -shm 은 SQLite 가 마지막 커넥션을 닫을 때 스스로 지운다
#     · bokguon.log 는 애플리케이션이 뜬 **뒤에** 만든다
#   즉 정상 상태에서도 없을 수 있는 파일들이라, 나열하는 순간 기동 실패로 이어진다.
#   디렉터리 단위로 열어 두는 것이 옳다.
#   (앱 디렉터리 안에 DB·로그·업로드가 함께 있으므로 이 한 줄로 모두 커버된다)
ReadWritePaths=/opt/bokguon
ReadWritePaths=/var/backups/bokguon

# 네트워크
#  ⚠ 아래 두 줄은 "외부망 아웃바운드를 막는다"는 뜻이 아니다(323라운드에서 확인,
#    systemd 공식문서 근거) — 착각하기 쉬운 지점이라 정확히 적어 둔다.
#    · RestrictAddressFamilies 는 소켓 프로토콜군(AF_INET 등 어떤 종류의 소켓을
#      만들 수 있는가)만 제한한다. 목적지 주소는 전혀 보지 않는다 — IPv4/IPv6를
#      허용목록에 넣은 시점에 사실상 인터넷 전체로 나가는 길이 열려 있다.
#    · IPAddressAllow=는 IPAddressDeny=any 와 짝을 이뤄야만 화이트리스트로
#      동작한다. 그 짝(아래엔 없음)이 없으면 이 유닛엔 IP 필터링이 전혀 안 걸려
#      있는 것과 같다(명시 안 된 트래픽도 전부 허용됨).
#    실제로 아웃바운드를 제한하려면 IPAddressDeny=any 를 추가하고, 이 서비스가
#    실제로 호출하는 외부 API(팝빌 등, notify_popbill.py)의 IP를 IPAddressAllow=
#    에 명시해야 한다 — 그 목록을 미리 확정하는 건 운영 판단이 필요해 이번엔
#    사실관계만 정정했다(IP가 바뀌면 알림 발송이 커널 단에서 조용히 끊기므로
#    신중한 검토 없이 임의로 추가하지 않음).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=localhost

# 시스템콜 — 일반적인 서비스 집합만 허용하고 권한 상승 계열은 차단
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io

# 자원 상한 — 폭주 시 서버 전체가 죽지 않도록
LimitNOFILE=4096
TasksMax=256

# .env는 시크릿이므로 소유자만 읽기(chmod 600) 권장
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bokguon

[Install]
WantedBy=multi-user.target
