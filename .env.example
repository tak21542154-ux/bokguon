# ══════════════════════════════════════════════════════════════
#  복구온 서비스 환경설정 예시
#  ㈜올림포스네트웍스 기획팀 유경탁
#
#  ⚠ 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#  ⚠ .env 는 절대 git 커밋·공유 금지 (시크릿 포함)
# ══════════════════════════════════════════════════════════════

# 실행 환경 — prod 로 설정하면 보안 검증이 강화되고 시크릿이 필수가 됩니다
BOKGUON_ENV=prod

# ── 필수 시크릿 (아래 명령으로 각각 생성) ─────────────────────
#   python -c "import secrets;print(secrets.token_hex(32))"
BOKGUON_SECRET_KEY=여기에_64자리_랜덤_16진수

#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BOKGUON_ENC_KEY=여기에_계좌번호_암호화키_base64
BOKGUON_INDEX_KEY=여기에_블라인드인덱스키_base64

# ── 서버 ──────────────────────────────────────────────────────
BOKGUON_HOST=0.0.0.0
BOKGUON_PORT=8771
BOKGUON_THREADS=8
# [420라운드][사용자결정] 팝빌 등 외부 API 소켓의 전역 기본 타임아웃(초) — SDK가
# 자체 타임아웃을 안 걸어 응답 없이 멈추면 스레드가 이 값까지 무한대기한다.
BOKGUON_SOCKET_TIMEOUT_SEC=30
# gunicorn(Linux) 사용 시
BOKGUON_BIND=127.0.0.1:8771
BOKGUON_WORKERS=5

# ── 리버스 프록시(nginx) 뒤에서 운영할 때 1 ───────────────────
BOKGUON_BEHIND_PROXY=1
BOKGUON_FORWARDED_ALLOW=127.0.0.1

# ── 보안 정책 ─────────────────────────────────────────────────
# 세션 만료(분)
BOKGUON_SESSION_MIN=30
# 로그인 실패 허용 횟수 / 잠금 시간(분)  — 안전성 확보조치 기준 §5·§6
BOKGUON_MAX_LOGIN_FAILS=5
BOKGUON_LOCKOUT_MIN=10
# 접속기록 보관일 — 원칙 365, 5만명↑ 또는 고유식별정보 처리 시 730 (고시 §8)
BOKGUON_LOG_RETENTION_DAYS=730
# 관리자 콘솔 접속 허용 IP (콤마 구분, 비우면 제한 없음) — 고시 §6 접근통제
# 예: BOKGUON_ADMIN_IP_ALLOW=203.0.113.10,203.0.113.11
BOKGUON_ADMIN_IP_ALLOW=

# ── 외부 접속(인터넷 공개) ────────────────────────────────────
# 허용할 접속 주소(Host). 프록시·터널 뒤에서는 **반드시 채울 것** —
# 비워 두면 X-Forwarded-Host 위조로 CSRF 방어(출처 검사)가 무력화된다.
# 임시 터널은 주소가 바뀌므로 외부접속_상시가동.ps1 이 자동으로 주입한다.
# 고정 도메인을 쓸 때만 여기에 적는다.
BOKGUON_ALLOWED_HOSTS=127.0.0.1,localhost

# 2단계 인증(일회용 비밀번호) 정책 — 개인정보 안전성 확보조치 기준 §6④
#   external(기본) : 사내망은 비밀번호만, **외부에서는 폰 코드 필수**
#   always         : 어디서든 코드 필수
#   off            : 끔 — 인터넷에 열지 않을 때만 (열려 있으면 법령 위반)
BOKGUON_OTP_POLICY=external

# ── 시공 사진 ─────────────────────────────────────────────────
# 업로드 저장 위치 (웹 루트 밖이어야 한다. 미설정 시 앱 디렉터리의 uploads/)
# 사진 일괄 업로드 요청 총량 상한(MB). nginx client_max_body_size 와 같은 값으로.
BOKGUON_MAX_UPLOAD_MB=260
BOKGUON_UPLOAD_DIR=
# AI 자동 분류 — 구글 AI 스튜디오 키를 넣으면 켜진다 (무료 등급 사용 가능)
# 비워두면 분류가 '미분류'로 남고 담당자가 직접 지정한다 (화면에도 그렇게 표시된다)
BOKGUON_GEMINI_KEY=
BOKGUON_GEMINI_MODEL=gemini-2.0-flash

# ── 알림 발송 (팝빌 popbill.com) ──────────────────────────────
# 아래 POPBILL_* 4개를 채우고 이 스위치를 1 로 켜면 문자 실발송이 시작된다.
# 절차: 팝빌 가입 → 연동인증 키 발급 → 발신번호 사전등록 → 값 입력 → 재시작
#       (상세: deploy/팝빌_연동가이드.md)
# 스위치가 0 이거나 키가 비어 있으면 지금처럼 '발송대기'로만 기록된다.
BOKGUON_NOTIFY_ENABLED=0

# 팝빌 연동인증 키 (팝빌 > 연동관리 > 연동인증 관리)
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# 사업자번호 (숫자만, 하이픈 무관) — 올림포스네트웍스 656-87-02554
POPBILL_CORP_NUM=
# 발신번호 — 팝빌에 **사전등록·승인된** 번호만 가능 (통신사 심사 1~2일)
POPBILL_SENDER=
# 팝빌 회원 아이디 (선택 — 연동회원 관리용)
POPBILL_USER_ID=
# 1 = 테스트베드(과금·실수신 없음, 기본값) / 0 = 운영 발송
POPBILL_TEST=1
# 알림톡 템플릿코드 (선택 — 카카오 채널·템플릿 승인 후 입력, 없으면 문자로 발송)
POPBILL_ATS_TEMPLATE=
